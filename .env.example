# Kopier til .env.local og fyll inn. .env.local skal aldri inn i git.
# Uten nøkler kjører siden i testmodus: betaling simuleres, og e-post
# skrives til serverloggen i stedet for å bli sendt.

# Full adresse til siden, uten skråstrek til slutt. Brukes i lenker
# tilbake fra Vipps og Stripe.
NETTSTED_URL=http://localhost:5180

# Sett til 1 (eller «på») for demo i produksjon: simulert betaling, e-post
# til loggen, «Demo»-bånd øverst og ingen indeksering i søkemotorer.
# Lokalt er testmodus alltid på når nøkler mangler.
TESTMODUS=

# Krypterer bestillingen mens kunden er hos Vipps eller Stripe.
# Lag en med:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Påkrevd i produksjon. Lokalt lages en midlertidig nøkkel ved oppstart.
ORDRE_NOKKEL=

# --- Vipps MobilePay (ePayment API) ---------------------------------
# Hentes fra portal.vippsmobilepay.com etter at avtalen er på plass.
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
# test eller produksjon
VIPPS_MILJO=test

# --- Kort (Stripe Checkout) -------------------------------------------
# Hemmelig nøkkel fra dashboard.stripe.com. Bruk sk_test_ til testing.
STRIPE_SECRET_KEY=

# --- E-post (Resend) --------------------------------------------------
RESEND_API_KEY=
# Avsender må være et domene som er verifisert hos Resend.
VARSEL_FRA=Anker Solutions <ordre@ankersolutions.no>
# Hvor forespørsler og bestillinger skal sendes.
VARSEL_TIL=post@ankersolutions.no
